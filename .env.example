# Optional local AI. Requires Ollama running on this machine.
# Install: https://ollama.com  ·  Start: ollama serve  ·  Pull: ollama pull llama3.1:8b
SKILLSTITCH_AI=on
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Large models on CPU can take a while. Raise this for slower machines.
OLLAMA_TIMEOUT_MS=120000

# SQLite location. Defaults to ./data/skillstitch.db
# SKILLSTITCH_DB_PATH=./data/skillstitch.db
